<Window x:Class="PodBridge.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodBridge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        Opacity="0">

  <Window.Resources>
    <!-- Slim rounded battery bar. PART_Track / PART_Indicator are the names ProgressBar
         looks for; the indicator colour follows Foreground, which the triggers below
         switch to red (low) or green (charging) from the Core PopupBattery flags. -->
    <Style x:Key="BatteryBar" TargetType="ProgressBar">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="#FFF2F2F7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid Height="6">
              <Border x:Name="PART_Track" Background="#33FFFFFF" CornerRadius="3" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}" CornerRadius="3" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Low first, charging second: a charging gauge shows green even when low. -->
        <DataTrigger Binding="{Binding IsLow}" Value="True">
          <Setter Property="Foreground" Value="#FFFF453A" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Charging}" Value="True">
          <Setter Property="Foreground" Value="#FF30D158" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ChargingMark" TargetType="TextBlock">
      <Setter Property="Text" Value="" />
      <Setter Property="Foreground" Value="#FF30D158" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Charging}" Value="True">
          <Setter Property="Text" Value="⚡" />
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <!-- The outer Margin leaves room for the drop shadow inside the transparent window. -->
  <Border Margin="16" Width="300" Padding="18,16,18,8" CornerRadius="20"
          Background="#F01C1C21" BorderBrush="#26FFFFFF" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black" />
    </Border.Effect>

    <StackPanel>
      <!-- Header: a generic headphones glyph (no Apple logo), the model name, status. -->
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="26" Foreground="#FFF2F2F7" VerticalAlignment="Center" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                     Foreground="#FFF2F2F7" />
          <TextBlock Text="Connected" FontSize="12" Foreground="#99FFFFFF" Margin="0,1,0,0" />
        </StackPanel>
      </StackPanel>

      <!-- One row per gauge the model reports: label, bar, charging mark + percent. -->
      <ItemsControl ItemsSource="{Binding Batteries}" Margin="0,16,0,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="64" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#B3FFFFFF"
                         VerticalAlignment="Center" />
              <ProgressBar Grid.Column="1" Style="{StaticResource BatteryBar}"
                           Value="{Binding BarPercent, Mode=OneWay}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Style="{StaticResource ChargingMark}" />
                <TextBlock Text="{Binding PercentText}" FontSize="13" Foreground="#FFF2F2F7"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
