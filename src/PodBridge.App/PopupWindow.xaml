<Window x:Class="PodBridge.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PodBridge.App"
        Title="PodBridge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">

  <Window.Resources>
    <local:RingDashConverter x:Key="RingDash" />

    <!-- The coloured arc of a gauge. White by default, red when low, green when charging
         (low first, charging second: a charging gauge shows green even when low). The dash
         array is computed from the percentage by RingDashConverter. An unknown level draws
         no arc at all. -->
    <Style x:Key="RingProgress" TargetType="Ellipse">
      <Setter Property="Stroke" Value="#FFF2F2F7" />
      <Setter Property="StrokeThickness" Value="7" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeDashCap" Value="Round" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <RotateTransform Angle="-90" />
        </Setter.Value>
      </Setter>
      <Setter Property="StrokeDashArray"
              Value="{Binding BarPercent, Converter={StaticResource RingDash}}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLow}" Value="True">
          <Setter Property="Stroke" Value="#FFFF453A" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Charging}" Value="True">
          <Setter Property="Stroke" Value="#FF30D158" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ChargingMark" TargetType="TextBlock">
      <Setter Property="Text" Value="⚡" />
      <Setter Property="Foreground" Value="#FF30D158" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Charging}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <!-- The window's bottom edge sits exactly on the top of the taskbar (work-area bottom), and
       the card starts below it, so it appears to rise out from behind the taskbar edge
       without ever overlapping it. The margins leave room for the shadow and the spring
       overshoot. The card starts invisible so nothing flashes before it is positioned. -->
  <Border x:Name="Card" Width="360" Margin="24,36,24,32" Padding="24,22,24,20"
          CornerRadius="28" Opacity="0"
          Background="#F21C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1">
    <Border.RenderTransform>
      <TranslateTransform x:Name="CardShift" />
    </Border.RenderTransform>
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black" />
    </Border.Effect>

    <StackPanel>
      <!-- Generic earbuds + charging case drawing (original shapes, no Apple artwork or logo). -->
      <Canvas Width="220" Height="84" HorizontalAlignment="Center">
        <!-- Left bud -->
        <Border Canvas.Left="30" Canvas.Top="36" Width="9" Height="34"
                CornerRadius="4.5" Background="#FFE5E5EA" />
        <Ellipse Canvas.Left="20" Canvas.Top="12" Width="30" Height="32" Fill="#FFF2F2F7" />
        <!-- Right bud -->
        <Border Canvas.Left="181" Canvas.Top="36" Width="9" Height="34"
                CornerRadius="4.5" Background="#FFE5E5EA" />
        <Ellipse Canvas.Left="170" Canvas.Top="12" Width="30" Height="32" Fill="#FFF2F2F7" />
        <!-- Case: body, lid seam and status light -->
        <Border Canvas.Left="72" Canvas.Top="14" Width="76" Height="62"
                CornerRadius="20" Background="#FFF2F2F7" />
        <Rectangle Canvas.Left="72" Canvas.Top="34" Width="76" Height="2" Fill="#26000000" />
        <Ellipse Canvas.Left="107" Canvas.Top="52" Width="6" Height="6" Fill="#FF30D158" />
      </Canvas>

      <TextBlock Text="{Binding Title}" Margin="0,14,0,0" HorizontalAlignment="Center"
                 FontSize="20" FontWeight="SemiBold" Foreground="#FFF2F2F7" />
      <TextBlock Text="Connected" Margin="0,2,0,0" HorizontalAlignment="Center"
                 FontSize="13" Foreground="#99FFFFFF" />

      <!-- One ring per component the model reports: ring + percent, then label. -->
      <ItemsControl ItemsSource="{Binding Batteries}" Margin="0,18,0,0"
                    HorizontalAlignment="Center" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="12,0" HorizontalAlignment="Center">
              <Grid Width="72" Height="72">
                <Ellipse Stroke="#33FFFFFF" StrokeThickness="7" />
                <Ellipse Style="{StaticResource RingProgress}" />
                <TextBlock Text="{Binding PercentText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#FFF2F2F7" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource ChargingMark}" />
                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#B3FFFFFF" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
